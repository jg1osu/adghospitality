# Server-only settings for the Vercel /api/inquiry function.
# Copy to .env.local for local testing; set the same variables in Vercel Settings.
# Never commit actual values or put them in public/config.js.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=alisa@adghospitality.com
# A mailbox on a domain verified with Resend. Use an email address, no display name.
INQUIRY_FROM_EMAIL=
# Suggested sender after verification: website@adghospitality.com
# Optional stricter production origin. Example: https://www.your-domain.com
# Set only after choosing your real domain. Leave unset for Vercel preview URLs.
INQUIRY_SITE_ORIGIN=

# HostGator PHP alternative: use environment settings or a private PHP config file.
# The PHP file must be OUTSIDE public_html; never upload the config into public/.
# Optional explicit absolute path; otherwise ../adg-inquiry-config.php above document root.
ADG_INQUIRY_CONFIG_PATH=
# Optional private, writable directory for PHP retry deduplication (outside public_html).
ADG_INQUIRY_STATE_DIR=
